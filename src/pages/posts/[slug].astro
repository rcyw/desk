---
import ArticleDocument from '../../components/ArticleDocument.astro';
import { readBlog } from '../../lib/blog';
import type { BlogPost, BlogTopic } from '../../lib/blog';
import { postId } from '../../lib/content-paths';

export async function getStaticPaths() {
  const { posts, topics } = await readBlog();
  return posts.map((post) => ({
    params: { slug: postId(post.id) },
    props: {
      post,
      topics: topics.filter((topic) =>
        post.data.topics.some(({ id }) => id === topic.id),
      ),
    },
  }));
}

interface Props {
  post: BlogPost;
  topics: BlogTopic[];
}

const { post, topics } = Astro.props;
---

<ArticleDocument entry={post} topics={topics} />
