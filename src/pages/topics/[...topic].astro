---
import PostList from '../../components/PostList.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { paginatePosts, readBlog, topicHref } from '../../lib/blog';
import type { BlogTopic, PostPage } from '../../lib/blog';

export async function getStaticPaths() {
  const { topics } = await readBlog();
  return topics.flatMap((topic) =>
    paginatePosts(topic.posts, topicHref(topic.id)).map((page) => ({
      params: { topic: page.path.slice('/topics/'.length, -1) },
      props: { topic, page },
    })),
  );
}

interface Props {
  topic: BlogTopic;
  page: PostPage;
}

const { topic, page } = Astro.props;
const title = page.current > 1 ? `${topic.data.title} · Page ${page.current}` : topic.data.title;
---

<SiteLayout title={title} description={topic.data.description} pagination={page}>
  <header class="blog-heading">
    <h1 lang={topic.data.lang}>{topic.data.title}</h1>
  </header>
  <PostList posts={page.posts} />
</SiteLayout>
