---
import BlogIndex from '../../components/BlogIndex.astro';
import { readBlogPages } from '../../lib/blog';
import { deskApps } from '../../lib/desk-apps';

export async function getStaticPaths() {
  const pages = await readBlogPages();
  return pages.map((page) => ({
    params: {
      page: page.path.slice(deskApps.blog.entryPath.length, -1) || undefined,
    },
    props: { page },
  }));
}
---

<BlogIndex page={Astro.props.page} />
