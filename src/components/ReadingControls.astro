<reading-controls class="reading-controls" lang="en" hidden>
  <div class="reading-size" role="group" aria-label="Text size">
    <span aria-hidden="true">Text</span>
    <button
      type="button"
      class="p9-button surface-button"
      data-size-step="-1"
      aria-label="Decrease text size"
      title="Decrease text size"
    >
      <span aria-hidden="true">−</span>
    </button>
    <button
      type="button"
      class="p9-button surface-button"
      data-size-step="1"
      aria-label="Increase text size"
      title="Increase text size"
    >
      <span aria-hidden="true">+</span>
    </button>
    <span class="visually-hidden" role="status" data-size-status></span>
  </div>

  <div class="reading-themes" role="group" aria-label="Reading theme">
    <button
      type="button"
      class="p9-button surface-button"
      data-theme-option="light"
      aria-label="Light"
      title="Light"
    >
      <span class="reading-icon reading-icon-sun" aria-hidden="true"></span>
    </button>
    <button
      type="button"
      class="p9-button surface-button"
      data-theme-option="dark"
      aria-label="Dark"
      title="Dark"
    >
      <span class="reading-icon reading-icon-moon" aria-hidden="true"></span>
    </button>
  </div>
</reading-controls>
