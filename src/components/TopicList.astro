---
import { topicHref, type Topic } from '../lib/topics';
import { PixelIcon } from '../platinum';

interface Props {
  topics: { topic: Topic; entries: readonly unknown[] }[];
}

const { topics } = Astro.props;
---

<ul class="topic-list" role="list">
  {topics.map(({ topic, entries }) => {
    const isProjectTopic = topic.collection === 'githubTopics';
    return (
      <li>
        <a class="topic-preview" href={topicHref(topic)}>
          {isProjectTopic && <PixelIcon name="folder" size={16} />}
          <div class="post-preview-copy" lang={topic.data.lang}>
            <h2>{topic.data.title}</h2>
            <p>{topic.data.description}</p>
          </div>
          {isProjectTopic ? (
            <span class="topic-meta" lang="en">
              {entries.length}
              <span class="visually-hidden">
                {entries.length === 1 ? ' project' : ' projects'}
              </span>
            </span>
          ) : (
            <span class="topic-meta" aria-hidden="true">
              →
            </span>
          )}
        </a>
      </li>
    );
  })}
</ul>
