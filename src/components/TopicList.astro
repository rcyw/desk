---
import { topicHref } from '../lib/blog';
import type { BlogTopic } from '../lib/blog';

interface Props {
  topics: BlogTopic[];
}

const { topics } = Astro.props;
---

<ul class="topic-list" role="list">
  {
    topics.map(({ id, data }) => (
      <li>
        <a class="topic-preview" href={topicHref(id)}>
          <div class="post-preview-copy" lang={data.lang}>
            <h2>{data.title}</h2>
            <p>{data.description}</p>
          </div>
          <span class="topic-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ul>
