---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DocumentLayout from '../layouts/DocumentLayout.astro';
import PromptCopy from './PromptCopy.astro';
import { topicHref } from '../lib/blog';
import type { BlogPost } from '../lib/blog';
import { briefName } from '../lib/briefs';
import type { Brief } from '../lib/briefs';
import type { Paper } from '../lib/papers';
import { PixelIcon } from '../platinum';
import '../styles/paper-document.css';

interface Props {
  entry: BlogPost | Brief | Paper | CollectionEntry<'prompts'>;
  topics?: CollectionEntry<'topics'>[];
  issueDate?: string;
}

const { entry, topics = [], issueDate } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, lang, publishedAt, updatedAt, sources } =
  entry.data;
const kind = 'kind' in entry.data ? entry.data.kind : 'note';
const paper = 'paper' in entry.data ? entry.data.paper : undefined;
const isPrompt = entry.collection === 'prompts';
const library =
  entry.collection === 'papers' || isPrompt ? entry.collection : undefined;
const outline = headings.filter(({ depth }) => depth === 2 || depth === 3);
const date = issueDate ?? publishedAt;
---

<DocumentLayout
  title={title}
  description={description}
  lang={lang}
  kind={kind}
  topic={library ? undefined : topics[0]}
  issueDate={issueDate}
  library={library}
>
  <article aria-labelledby="article-title">
    <header class="article-header">
      <div class="article-meta" lang="en">
        {!isPrompt && (
          <span class="article-type">
            {paper
              ? 'Paper Note'
              : issueDate
                ? briefName
                : kind === 'note'
                  ? 'Note'
                  : 'Article'}
          </span>
        )}
        <time datetime={date}>{date}</time>
        {issueDate && publishedAt !== issueDate && (
          <span>
            Published <time datetime={publishedAt}>{publishedAt}</time>
          </span>
        )}
        {updatedAt && (
          <span>
            Updated <time datetime={updatedAt}>{updatedAt}</time>
          </span>
        )}
      </div>
      <h1 id="article-title">{title}</h1>
      <p class="article-dek">{description}</p>
      {paper && (
        <aside class="paper-reference" aria-labelledby="paper-source-heading">
          <h2 id="paper-source-heading" lang="en">
            Original Paper
          </h2>
          <p>
            <a href={paper.url}>{paper.title}</a>
          </p>
          <p>
            {paper.source} <span aria-hidden="true">·</span> {paper.version}
          </p>
          {topics.length > 0 && (
            <ul class="paper-topic-labels" aria-label="Topics" role="list">
              {topics.map((topic) => (
                <li lang={topic.data.lang}>{topic.data.title}</li>
              ))}
            </ul>
          )}
        </aside>
      )}
    </header>

    <div class:list={['reading-layout', { 'has-outline': outline.length > 0 }]}>
      {outline.length > 0 && (
        <details class="document-outline" open={!issueDate && !library}>
          <summary lang="en">Contents</summary>
          <nav aria-label="Contents" lang="en">
            <ul role="list" lang={lang}>
              {outline.map(({ slug, text, depth }) => (
                <li class:list={{ 'outline-subheading': depth === 3 }}>
                  <a href={`#${slug}`}>{text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      )}

      <div class="reading-body">
        <div class:list={['article-prose', { 'prompt-prose': isPrompt }]}>
          <Content />
        </div>
        {isPrompt && <PromptCopy />}

        {sources && sources.length > 0 && (
          <section class="article-sources" aria-labelledby="sources-heading">
            <h2 id="sources-heading" lang="en">
              Sources
            </h2>
            <ul>
              {sources.map(({ label, url, revision }) => (
                <li>
                  {url ? <a href={url}>{label}</a> : <span>{label}</span>}
                  {revision && <code>{revision}</code>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {!library && topics.length > 0 && (
          <nav class="article-topics" aria-label="Topics" lang="en">
            {topics.map((topic) => (
              <a
                class="document-folder"
                href={topicHref(topic.id)}
                lang={topic.data.lang}
              >
                <PixelIcon name="folder" size={16} />
                {topic.data.title}
              </a>
            ))}
          </nav>
        )}
      </div>
    </div>
  </article>
</DocumentLayout>
