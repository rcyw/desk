---
import DeskSurface from '../components/DeskSurface.astro';
import type { DeskApp } from '../components/Desk';
import ReadingControls from '../components/ReadingControls.astro';
import { blogName } from '../lib/blog';
import type { PostPage } from '../lib/blog';
import { briefName } from '../lib/briefs';
import PageLayout from './PageLayout.astro';
import '../styles/blog.css';
import '../styles/brief.css';

interface Props {
  app?: DeskApp;
  title?: string;
  description?: string;
  robots?: 'noindex';
  pagination?: PostPage;
}

const { app = 'blog', title, description, robots, pagination } = Astro.props;
const pathname = Astro.url.pathname;
const brief = app === 'brief';
const mainId = brief ? 'brief-content' : 'main-content';
const home = pathname === '/';
const topics = pathname.startsWith('/topics/');
const topicIndex = pathname === '/topics/';
const homeArchive = pathname.startsWith('/page/');
const desktopHeight = brief
  ? 380
  : Math.max(340, Math.min(560, 200 + 40 * (pagination?.maxRows ?? 4))) -
    (home || homeArchive ? 48 : 0);
const navigation: {
  label: string;
  href: string;
  current?: 'page' | 'location';
}[] = brief
  ? [
      {
        label: 'Latest',
        href: '/brief/',
        current: pathname === '/brief/' ? 'page' : undefined,
      },
      {
        label: 'Archive',
        href: '/brief/archive/',
        current:
          pathname === '/brief/archive/'
            ? 'page'
            : pathname.startsWith('/brief/archive/')
              ? 'location'
              : undefined,
      },
    ]
  : [
      {
        label: 'Home',
        href: '/',
        current: home ? 'page' : homeArchive ? 'location' : undefined,
      },
      {
        label: 'Topics',
        href: '/topics/',
        current: topicIndex ? 'page' : topics ? 'location' : undefined,
      },
    ];
---

<PageLayout
  title={title}
  description={description}
  surface="desktop"
  desktopHeight={desktopHeight}
  robots={robots}
  mainId={mainId}
>
  <DeskSurface
    blogTitle={blogName}
    briefTitle={briefName}
    app={app}
    height={desktopHeight}
    mainId={mainId}
  >
    <div class="blog-window">
      <nav
        class="blog-toolbar"
        aria-label={brief ? 'AI Brief navigation' : 'Blog navigation'}
      >
        {navigation.map(({ label, href, current }) => (
          <a
            class="p9-button surface-button"
            href={href}
            aria-current={current}
          >
            {label}
          </a>
        ))}
        {brief ? (
          <a class="blog-toolbar-link" href="/" data-desk-app="blog">
            Blog
          </a>
        ) : (
          <>
            <a
              class="blog-toolbar-link blog-brief-entry"
              href="/brief/"
              data-desk-app="brief"
            >
              {briefName}
            </a>
            <a class="blog-toolbar-link" href="https://github.com/rcyw">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </>
        )}
      </nav>

      <div
        class="blog-content"
        role="main"
        aria-label={brief ? briefName : blogName}
        id={mainId}
        tabindex="-1"
      >
        <div class="blog-page">
          <slot />
        </div>
      </div>

      <footer class="reading-footer blog-footer">
        {pagination && pagination.total > 1 && (
          <nav class="blog-pagination" aria-label="Pagination">
            <span class="pagination-count">
              <span class="pagination-count-word">Page </span>
              {pagination.current}
              <span class="pagination-count-word"> of </span>
              <span class="pagination-count-separator"> / </span>
              {pagination.total}
            </span>
            <div>
              {[
                { label: 'Newer', href: pagination.newer, rel: 'prev' },
                { label: 'Older', href: pagination.older, rel: 'next' },
              ].map(({ label, href, rel }) =>
                href ? (
                  <a
                    class="p9-button surface-button"
                    href={href}
                    rel={rel}
                    data-page-direction={rel}
                    aria-label={label}
                    title={`${label} posts`}
                  ></a>
                ) : (
                  <button
                    class="p9-button surface-button"
                    type="button"
                    data-page-direction={rel}
                    aria-label={label}
                    disabled
                  ></button>
                ),
              )}
            </div>
          </nav>
        )}
        <ReadingControls />
      </footer>
    </div>
  </DeskSurface>
</PageLayout>
