---
import DeskSurface from '../components/DeskSurface.astro';
import ReadingControls from '../components/ReadingControls.astro';
import { blogName } from '../lib/blog';
import type { PostPage } from '../lib/blog';
import { briefName } from '../lib/briefs';
import { deskAppIds, deskApps } from '../lib/desk-apps';
import type { DeskApp } from '../lib/desk-apps';
import PageLayout from './PageLayout.astro';
import '../styles/blog.css';
import '../styles/brief.css';

interface Props {
  app?: DeskApp;
  title?: string;
  description?: string;
  robots?: 'noindex';
  pagination?: PostPage;
}

const { app = 'blog', title, description, robots, pagination } = Astro.props;
const pathname = Astro.url.pathname;
const { label, mainId, height } = deskApps[app];
const appName = app === 'blog' ? blogName : label;
const appLinks = deskAppIds.filter((id) => id !== app);
const home = pathname === '/';
const topics = pathname.startsWith('/topics/');
const topicIndex = pathname === '/topics/';
const homeArchive = pathname.startsWith('/page/');
const desktopHeight =
  app === 'blog'
    ? Math.max(height, Math.min(560, 200 + 40 * (pagination?.maxRows ?? 4))) -
      (home || homeArchive ? 48 : 0)
    : height;
type NavLink = {
  label: string;
  href: string;
  current?: 'page' | 'location';
};
const links: Record<DeskApp, NavLink[]> = {
  blog: [
    {
      label: 'Home',
      href: deskApps.blog.entryPath,
      current: home ? 'page' : homeArchive ? 'location' : undefined,
    },
    {
      label: 'Topics',
      href: '/topics/',
      current: topicIndex ? 'page' : topics ? 'location' : undefined,
    },
  ],
  brief: [
    {
      label: 'Latest',
      href: deskApps.brief.entryPath,
      current: pathname === deskApps.brief.entryPath ? 'page' : undefined,
    },
    {
      label: 'Archive',
      href: '/brief/archive/',
      current:
        pathname === '/brief/archive/'
          ? 'page'
          : pathname.startsWith('/brief/archive/')
            ? 'location'
            : undefined,
    },
  ],
  papers: [
    {
      label: 'Library',
      href: deskApps.papers.entryPath,
      current: pathname === deskApps.papers.entryPath ? 'page' : undefined,
    },
  ],
};
---

<PageLayout
  title={title}
  description={description}
  surface="desktop"
  desktopHeight={desktopHeight}
  robots={robots}
  mainId={mainId}
>
  <DeskSurface
    blogTitle={blogName}
    briefTitle={briefName}
    app={app}
    height={desktopHeight}
    mainId={mainId}
  >
    <div class="blog-window">
      <nav class="blog-toolbar" aria-label={`${label} navigation`}>
        {links[app].map(({ label, href, current }) => (
          <a
            class="p9-button surface-button"
            href={href}
            aria-current={current}
          >
            {label}
          </a>
        ))}
        <div class="blog-toolbar-actions">
          {appLinks.map((id) => (
            <a
              class:list={[
                'blog-toolbar-link',
                { 'blog-mobile-app': id !== 'blog' },
              ]}
              href={deskApps[id].entryPath}
              data-desk-app={id}
            >
              {deskApps[id].label}
            </a>
          ))}
          {app === 'blog' && (
            <a
              class="blog-toolbar-link blog-github"
              href="https://github.com/rcyw"
              aria-label="GitHub"
              title="GitHub"
            >
              <span class="blog-github-label">GitHub</span>
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </nav>

      <div
        class="blog-content"
        role="main"
        aria-label={appName}
        id={mainId}
        tabindex="-1"
      >
        <div class="blog-page">
          <slot />
        </div>
      </div>

      <footer class="reading-footer blog-footer">
        {pagination && pagination.total > 1 && (
          <nav class="blog-pagination" aria-label="Pagination">
            <span class="pagination-count">
              <span class="pagination-count-word">Page </span>
              {pagination.current}
              <span class="pagination-count-word"> of </span>
              <span class="pagination-count-separator"> / </span>
              {pagination.total}
            </span>
            <div>
              {[
                { label: 'Newer', href: pagination.newer, rel: 'prev' },
                { label: 'Older', href: pagination.older, rel: 'next' },
              ].map(({ label, href, rel }) =>
                href ? (
                  <a
                    class="p9-button surface-button"
                    href={href}
                    rel={rel}
                    data-page-direction={rel}
                    aria-label={label}
                    title={`${label} posts`}
                  ></a>
                ) : (
                  <button
                    class="p9-button surface-button"
                    type="button"
                    data-page-direction={rel}
                    aria-label={label}
                    disabled
                  ></button>
                ),
              )}
            </div>
          </nav>
        )}
        <ReadingControls />
      </footer>
    </div>
  </DeskSurface>
</PageLayout>
